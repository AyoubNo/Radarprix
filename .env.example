# Development defaults are shown for local use only. Replace every example URL/secret in production.
NODE_ENV=development
PRIXRADAR_SITE_URL=http://localhost:3220
NEXT_PUBLIC_SITE_URL=http://localhost:3220
PRIXRADAR_API_INTERNAL_URL=http://127.0.0.1:3500
NEXT_PUBLIC_PRIXRADAR_API_URL=
NEXT_PUBLIC_PRIXRADAR_ENABLE_MANUAL_REFRESH=true

PRIXRADAR_DATA_DIR=./data
# PRIXRADAR_DB_PATH=/data/radarprix.sqlite.db
PRIXRADAR_BACKUP_DIR=./data/backups
PRIXRADAR_REFRESH_SECRET=change-me-with-a-long-random-value

PRIXRADAR_API_HOST=127.0.0.1
PRIXRADAR_API_PORT=3500
PRIXRADAR_WEB_PORT=3220
PORT=3500
PRIXRADAR_STARTUP_COLLECTION=true
PRIXRADAR_SHUTDOWN_GRACE_MS=25000

CHROMIUM_PATH=/usr/bin/chromium
